# Copia este archivo como .env en el servidor y cambia las contraseñas.
APP_PORT=8080
DB_NAME=oficina_proyectos
DB_USER=jjm_app
DB_PASSWORD=CAMBIAR_CONTRASENA_BD
MYSQL_ROOT_PASSWORD=CAMBIAR_CONTRASENA_ROOT

# Opcional: correo Gmail con contraseña de aplicación.
MAIL_USERNAME=
MAIL_PASSWORD=

# Opcional: memoria JVM.
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -Dfile.encoding=UTF-8
